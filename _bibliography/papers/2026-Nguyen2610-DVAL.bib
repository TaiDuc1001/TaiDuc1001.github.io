  AUTHOR="Lam Phuong Nguyen and Duc Tai Phan and Duc-Hieu Hoang and Tri Nguyen Thai and Cuong Tuan Nguyen and Duc Ngoc Minh Dang",
  TITLE="{DVAL:} Detector and {Vision-Language} Active Learning for Traffic Sign Detection",
  BOOKTITLE="2026 International Conference on Advanced Technologies for Communications (ATC'26)",
  booktitle_url={https://atc-conf.org/},
  ADDRESS="Quy Nhon, Vietnam",
  PAGES=6,
